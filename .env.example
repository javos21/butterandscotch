# Menu photo uploads (Cloudflare R2, S3-compatible). Leave unset locally to store photos in
# Supabase storage instead. R2_PUBLIC_URL is the bucket's public address (custom domain or r2.dev),
# with no trailing slash; it must also be set when the site is built so Next allows the image host.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
